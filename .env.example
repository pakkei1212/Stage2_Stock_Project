# ── .env.example ─────────────────────────────────────────────────────────────
# Copy this to .env and fill in values. docker compose reads .env automatically;
# scripts\start_scheduler.ps1 loads it for Windows (non-Docker) runs.
# .env is gitignored — never commit real credentials, and never put them here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets (no defaults anywhere in the code) ───────────────────────────────

# Required for live Stage G (Claude VCP analysis) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Telegram Bot API credentials (create a bot with @BotFather; see README "Telegram")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Jupyter ──────────────────────────────────────────────────────────────────

# Host port for Jupyter. Change if 8888 is taken.
JUPYTER_PORT=8888
# Optional Jupyter token. Leave blank to disable (fine for local use).
JUPYTER_TOKEN=

# ── Notebook runner service (docker compose --profile scheduled) ─────────────

# Cron schedule for the headless *notebook* runner (container time is UTC).
# Used ONLY by the Docker `runner` service. It does NOT control the Stage-H
# scheduler (see SCHEDULE_MODE below). PIPELINE_SCHEDULE is obsolete: nothing
# reads it any more and it can be deleted from an old .env.
SCHEDULE=0 18 * * 1-5
NOTEBOOK_NAME=nasdaq_stage2_screener.ipynb

# ── Stage G ──────────────────────────────────────────────────────────────────

ANTHROPIC_MODEL=claude-opus-4-8
# How many top-ranked candidates get charts + VCP analysis each run.
VCP_TOP_N=20
# 1 = send charts to Claude (spends tokens); 0 = token-free (metrics + charts only).
# Code default is 1; docker-compose defaults to 0. Set it explicitly.
VCP_LIVE_ANALYSIS=0
# Which candidates Claude reviews when VCP_LIVE_ANALYSIS=1:
#   selective (default) = numeric detector first; Claude only for acceptable/weak
#                         setups, strong setups at a fresh breakout or with wick/gap structure
#   all                 = every Stage-G candidate (research: numeric-vs-Claude data)
#   off                 = no Claude calls (metrics + verification charts only)
VCP_LLM_REVIEW_MODE=selective

# ── Logging / cache ──────────────────────────────────────────────────────────

LOG_LEVEL=INFO
OHLCV_CACHE=1

# ── Main Stage-H scheduling (pipeline/scheduler.py) ──────────────────────────
# WHEN the long-running scheduler checks. Checks run every calendar day (weekends
# too). A more frequent check does NOT run Stage A-G more often: the pipeline runs
# at most once per completed NASDAQ session; extra checks just skip.
SCHEDULE_ENABLED=1

# daily | times | interval   (missing or blank = daily; recommended: daily)
SCHEDULE_MODE=daily

# Timezone for every mode (and for DEFERRED_RETRY_CUTOFF).
LOCAL_SCHEDULER_TIMEZONE=Asia/Singapore

# SCHEDULE_MODE=daily    -> one check per day at this local time (HH:MM)
LOCAL_SCHEDULER_TIME=09:15

# SCHEDULE_MODE=times    -> a check at each listed local time (HH:MM, comma-separated,
#                           no duplicates), e.g. 09:15,13:00,18:00. Ignored otherwise.
SCHEDULE_TIMES=

# SCHEDULE_MODE=interval -> a check every N minutes after the previous check
#                           (whole number, 15-1440). Ignored otherwise.
SCHEDULE_INTERVAL_MINUTES=60

# Check immediately when the scheduler starts (late laptop start / catch-up), in every mode.
RUN_ON_STARTUP_CHECK=1
# A session counts as completed this many minutes after its (possibly early) close.
SESSION_CLOSE_BUFFER_MINUTES=60

# Data-readiness guard: the reference index's latest daily bar must equal the
# target session before Stage A-G starts.
DATA_READY_SYMBOL=^IXIC
DATA_READY_RETRY_MINUTES=10
DATA_READY_MAX_ATTEMPTS=3
# Still not ready after those short retries: keep the session pending and
# re-probe readiness (no Stage A-G) every N minutes until the local cutoff.
DEFERRED_RETRY_ENABLED=1
DEFERRED_RETRY_MINUTES=60
DEFERRED_RETRY_CUTOFF=20:30

# ── Stage H: history + trends ────────────────────────────────────────────────

HISTORY_DB_PATH=data/history/stage2_history.sqlite3
TREND_TOP_N=10
TREND_LOOKBACK_SESSIONS=10
TREND_RANK_MOVE_MIN=3
TREND_PERSISTENT_MIN_STREAK=3

# ── Stage H: Telegram ────────────────────────────────────────────────────────

TELEGRAM_ENABLED=0
TELEGRAM_SEND_CHARTS=1
# VCP verification charts sent for the VCP review set, in VCP priority order
# (TELEGRAM_CHART_TOP_N is no longer used). A READY setup's chart carries its
# Open Position / View Position button (needs TRADE_BOT_ENABLED=1).
TELEGRAM_VCP_CHART_MAX=10
TELEGRAM_OPS_ALERTS=1
# Rows in the "📊 Overall leaders" section of the main report.
TELEGRAM_REPORT_CANDIDATES=10
# 1 = also send a separate 🛠 debug message (stage counts, Stage G/I, position
# monitor, corporate actions, run facts). The main report never contains them.
TELEGRAM_DEBUG_SUMMARY=1

# ── Stage I: trade journal + position monitor (advisory only) ────────────────
# This layer records the fills YOU report (Telegram or CLI), calculates entry /
# stop / sizing plans and monitors open positions on public market data.
#
#   NO brokerage API · NO IBKR credentials · NO account access
#   NO order placement · NO automatic execution
#
# Nothing here can buy or sell anything. Every threshold below is one of OUR
# provisional strategy heuristics (not a Minervini rule) and should be
# re-evaluated once there is recorded trade history.

TRADE_JOURNAL_ENABLED=1
# Separate database file — real trades never share tables with screening history.
TRADE_DB_PATH=data/trades/trade_journal.sqlite3

# Planning parameters. PORTFOLIO_VALUE is a number YOU type here; no broker
# balance is ever read. Suggested size = min(risk-based, portion-based).
PORTFOLIO_VALUE=100000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PORTION_PCT=25

# Layer 2 — entry plan (the numeric VCP pivot is always the authoritative entry
# reference; breakout volume reuses the Stage-G threshold).
ENTRY_TRIGGER_BUFFER_PCT=0.1
MAX_CHASE_PCT=5.0

# Layer 3 — initial risk plan. Structure first (final contraction low), with a
# volatility floor; market cap / liquidity only modify the ceiling. A required
# stop wider than the ceiling is SKIP_RISK_TOO_WIDE, never a wider stop.
ATR_PERIOD=20
ATR_STOP_MULTIPLE=2.0
STRUCTURAL_STOP_BUFFER_PCT=1.0
SWING_LOOKBACK_DAYS=20
SWING_EXCLUDE_RECENT_DAYS=3
MAX_RISK_PCT=10
DEFAULT_RISK_CEILING_PCT=8
DEFAULT_TRAIL_ATR_MULTIPLE=2.5
LIQUIDITY_FLOOR_USD=20000000
ILLIQUID_CEILING_FACTOR=0.8
HIGH_VOLATILITY_ATR_PCT=5.0
HIGH_VOLATILITY_TRAIL_BONUS=0.5

# Winning-exit monitoring: each profit cushion unlocks a tighter protective
# reference. There is deliberately no universal "take profit at +20%" rule.
BREAKEVEN_CUSHION_PCT=5
SWING_TRAIL_CUSHION_PCT=8
EMA21_TRAIL_CUSHION_PCT=12
EMA10_TRAIL_CUSHION_PCT=25
PARTIAL_PROFIT_CUSHION_PCT=20
CLIMAX_EXT_EMA10_PCT=15
FAILED_BREAKOUT_DAYS=15
FAILED_BREAKOUT_PCT=3
REVERSAL_VOLUME_RATIO=2.0
REVERSAL_CLOSE_LOCATION=0.35
TRADE_MONITOR_LOOKBACK_DAYS=260
# Append the "Open positions" section to the daily Telegram report.
TRADE_POSITIONS_IN_REPORT=1

# ── Stage I: corporate actions (advisory, runs before the position monitor) ──
# Splits, reverse splits, stock dividends, cash dividends and unambiguous ticker
# changes are applied to the journal's DERIVED values (shares, average cost,
# stops, pivots). Mergers, spin-offs, rights and delistings are recorded and
# flagged for manual review — no cost basis, exchange ratio or share quantity is
# ever guessed. Nothing here touches a broker, and Stage A-G is unaffected.
CORPORATE_ACTIONS_ENABLED=1
# How far back a newly-probed symbol is asked about (bounded by the entry date).
CORPORATE_ACTION_LOOKBACK_DAYS=400
# Special-dividend heuristics (OURS, provisional): a payment worth at least this
# much of the reference price, or this many times the recent regular dividends,
# is treated as special and the position is flagged so you can review the stop.
SPECIAL_DIVIDEND_YIELD_PCT=3.0
SPECIAL_DIVIDEND_MULTIPLE=3.0
# Only relevant if the OHLCV source ever stops being adjusted: how long after an
# ex-date a dividend is still considered when judging a price move. With
# yfinance's auto_adjust=True bars this is a no-op — the drop is already gone,
# and compensating again would double-count.
DIVIDEND_SIGNAL_WINDOW_SESSIONS=3
# Consecutive sessions with no market data before an open position is put into
# CORPORATE_ACTION_REVIEW. Missing data is never treated as a sale.
MISSING_BARS_REVIEW_SESSIONS=3

# ── Stage I: Telegram trade-journal bot (separate process) ───────────────────
# python -m pipeline.trade_bot   (scripts\start_trade_bot.ps1 on Windows)
# Set to 1 to also attach a "Record Buy" button to READY VCP alerts.
TRADE_BOT_ENABLED=0
TRADE_BOT_POLL_SECONDS=20
TRADE_CONFIRM_TTL_MINUTES=30

# Authorization allowlist for /buy, /sell, /close and every inline button.
# Updates from any other chat are ignored entirely. Falls back to
# TELEGRAM_CHAT_ID when empty; comma-separated for several chats.
TELEGRAM_ALLOWED_CHAT_ID=
# Optional extra narrowing: only these Telegram user ids may mutate.
TELEGRAM_ALLOWED_USER_ID=

# Optional (Docker only — the image has no .git): commit hash recorded per run.
GIT_COMMIT=
